# Copie para server/.env e ajuste. Tudo é opcional em desenvolvimento.

# PostgreSQL. Sem esta variável, o servidor usa um Postgres embutido (PGlite) em server/.data.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/ajudaai

# Obrigatório em produção (NODE_ENV=production).
# JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Porta da API em produção (em desenvolvimento é sempre 3000).
# PORT=3000

# Endereço do site, usado nos links enviados por e-mail.
# APP_URL=http://localhost:5173

# SMTP. Sem SMTP_HOST, os e-mails são impressos no console do servidor.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Ajuda Aí <nao-responda@ajudaai.app>
